# Copia este fichero a `.env` (mismo directorio que compose.yaml) y rellena los valores.
# `.env` NO debe subirse a git (está en .gitignore).

# Contraseña de la BD `roundcube` en la MariaDB del NAS.
# ⚠️ La política de contraseñas de MariaDB exige mayúsculas, minúsculas, dígitos Y símbolos.
ROUNDCUBEMAIL_DB_PASSWORD=pon-aqui-una-contrasena-fuerte-con-simbolos

# Clave de cifrado de Roundcube (24+ caracteres aleatorios). No cambies este valor
# una vez haya datos, o se perderá el acceso a los datos cifrados almacenados.
ROUNDCUBEMAIL_DES_KEY=pon-aqui-24-caracteres-aleatorios
